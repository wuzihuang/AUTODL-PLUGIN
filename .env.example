# Copy this file to .env and replace the placeholder.
# Never commit your real AutoDL developer token.
AUTODL_TOKEN=replace-with-your-developer-token

# Optional overrides.
AUTODL_BASE_URL=https://api.autodl.com
AUTODL_WEB_BASE_URL=https://www.autodl.com
AUTODL_METRICS_URL=http://127.0.0.1:2022/autopanel/v1/api/monitor/current
AUTODL_REQUEST_TIMEOUT_MS=20000
